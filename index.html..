<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>MRL India – Stock CRM</title>
<style>
:root{--bg:#f5f6f8;--card:#fff;--tx:#1b1f24;--mu:#667085;--bd:#e1e4ea;--pr:#1d4ed8;--in:#15803d;--out:#c2410c;--bad:#b91c1c;color-scheme:light}
@media (prefers-color-scheme:dark){:root{--bg:#111418;--card:#1a1f26;--tx:#eceff4;--mu:#9aa4b2;--bd:#2c333d;--pr:#6b95ff;--in:#4ade80;--out:#fb923c;--bad:#f87171;color-scheme:dark}}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--tx);font:15px/1.45 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif}
.wrap{max-width:900px;margin:0 auto;padding:14px}
.card{background:var(--card);border:1px solid var(--bd);border-radius:12px;padding:14px;margin-bottom:12px}
h1{font-size:18px;margin:0}h2{font-size:16px;margin:0 0 10px}
.top{display:flex;justify-content:space-between;align-items:center;gap:8px;margin-bottom:12px}
.mu{color:var(--mu);font-size:13px}
.tabs{display:flex;gap:6px;overflow-x:auto;margin-bottom:12px}
.tabs button{flex:1;white-space:nowrap}
button{font:inherit;padding:9px 14px;border-radius:8px;border:1px solid var(--bd);background:var(--card);color:var(--tx);cursor:pointer}
button.on,button.pri{background:var(--pr);color:#fff;border-color:var(--pr)}
button.sm{padding:4px 9px;font-size:13px}
label{display:block;font-size:13px;color:var(--mu);margin:8px 0 3px}
input,select{width:100%;font:inherit;padding:9px;border-radius:8px;border:1px solid var(--bd);background:var(--bg);color:var(--tx)}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:0 10px}
@media(max-width:520px){.grid{grid-template-columns:1fr}}
.tw{overflow-x:auto}
table{width:100%;border-collapse:collapse;font-size:14px}
th,td{text-align:left;padding:8px 6px;border-bottom:1px solid var(--bd);white-space:nowrap}
th{color:var(--mu);font-weight:600;font-size:12px}
.in{color:var(--in);font-weight:600}.out{color:var(--out);font-weight:600}.bad{color:var(--bad)}
.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-bottom:12px}
.stats div{background:var(--card);border:1px solid var(--bd);border-radius:12px;padding:10px;text-align:center}
.stats b{display:block;font-size:20px}
.msg{padding:8px 10px;border-radius:8px;margin-top:10px;font-size:14px;display:none}
.msg.ok{display:block;background:rgba(21,128,61,.15);color:var(--in)}
.msg.err{display:block;background:rgba(185,28,28,.15);color:var(--bad)}
.hide{display:none}
</style>
</head>
<body>
<div class="wrap">

<div id="login" class="card" style="max-width:380px;margin:12vh auto 0">
  <h1>MRL India</h1>
  <div class="mu">Stock Inward / Outward CRM</div>
  <label>Email</label><input id="lu" type="email" autocomplete="username" autocapitalize="none">
  <label>Password</label><input id="lp" type="password" autocomplete="current-password">
  <button class="pri" style="width:100%;margin-top:14px" id="loginBtn">Login</button>
  <div id="lm" class="msg"></div>
</div>

<div id="app" class="hide">
  <div class="top">
    <div><h1>MRL India · Stock CRM</h1><div class="mu" id="who"></div><div class="mu" id="cs"></div></div>
    <button class="sm" id="logoutBtn">Logout</button>
  </div>
  <div class="stats">
    <div><b id="s1">0</b><span class="mu">Items</span></div>
    <div><b id="s2" class="in">0</b><span class="mu">Total in</span></div>
    <div><b id="s3" class="out">0</b><span class="mu">Total out</span></div>
  </div>
  <div class="tabs" id="tabs">
    <button data-t="stock" class="on">Stock</button>
    <button data-t="inward">Inward</button>
    <button data-t="outward">Outward</button>
    <button data-t="history">History</button>
  </div>

  <div id="t-stock" class="card">
    <h2>Current stock</h2>
    <input id="q" placeholder="Search item…" style="margin-bottom:10px">
    <div class="tw"><table><thead><tr><th>Category</th><th>Item</th><th>Unit</th><th>In</th><th>Out</th><th>Balance</th></tr></thead><tbody id="stk"></tbody></table></div>
  </div>

  <div id="t-inward" class="card hide">
    <h2>Stock inward (receive)</h2>
    <div class="grid">
      <div><label>Date</label><input type="date" id="i_d"></div>
      <div><label>Category</label><select id="i_cat"><option>TV</option><option>Speaker</option><option>Stabilizer</option></select></div>
      <div><label>Product</label><select id="i_c"></select></div>
      <div><label>Unit</label><input id="i_u" value="pcs"></div>
      <div><label>Quantity</label><input type="number" id="i_q" min="0" step="any"></div>
      <div><label>Supplier</label><input id="i_p"></div>
      <div><label>Invoice / GRN no.</label><input id="i_r"></div>
      <div><label>Remarks</label><input id="i_k"></div>
    </div>
    <button class="pri" style="margin-top:12px;width:100%" id="addIn">Save inward</button>
    <div id="im" class="msg"></div>
  </div>

  <div id="t-outward" class="card hide">
    <h2>Stock outward (dispatch)</h2>
    <div class="grid">
      <div><label>Date</label><input type="date" id="o_d"></div>
      <div><label>Item</label><select id="o_c"></select></div>
      <div><label>Quantity</label><input type="number" id="o_q" min="0" step="any"><div class="mu" id="o_a"></div></div>
      <div><label>Customer</label><input id="o_p"></div>
      <div><label>Challan / Invoice no.</label><input id="o_r"></div>
      <div><label>Remarks</label><input id="o_k"></div>
    </div>
    <button class="pri" style="margin-top:12px;width:100%" id="addOut">Save outward</button>
    <div id="om" class="msg"></div>
  </div>

  <div id="t-history" class="card hide">
    <div class="top"><h2 style="margin:0">All entries</h2><button class="sm" id="csvBtn">Export CSV</button></div>
    <div class="tw"><table><thead><tr><th>Date</th><th>Type</th><th>Code</th><th>Item</th><th>Qty</th><th>Party</th><th>Ref</th><th>By</th><th></th></tr></thead><tbody id="hist"></tbody></table></div>
  </div>
</div>
</div>

<script type="module">
import {initializeApp} from "https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js";
import {getAuth,signInWithEmailAndPassword,signOut,onAuthStateChanged} from "https://www.gstatic.com/firebasejs/10.12.2/firebase-auth.js";
import {getFirestore,collection,doc,setDoc,deleteDoc,onSnapshot} from "https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore.js";

/* ====== STEP 1: PASTE YOUR FIREBASE CONFIG HERE ====== */
const firebaseConfig = {
  apiKey: "AIzaSyBVWpb6eyvusmDavWZ_3WMbvBXNHwa7rCo",
  authDomain: "mrl-stock-crm.firebaseapp.com",
  projectId: "mrl-stock-crm",
  appId: "1:258202335206:web:400e74a26e9e41d2968827"
};
/* Admin emails (can delete entries). Must match the Firestore rules. */
const ADMINS = ["sakthimrl124@gmail.com"];
/* ====================================================== */

const CAT={"TV":["24Apro","32NFL","32Apro","40Apro","43Apro","43Apro4k","50Apro","50Webos","55Apro","55Webos","65Apro","65Webos"],"Speaker":["SPECTRA","VIBE VERSE","HD-108","T-6666","FLAME","HARMONY X","FUSION MIX","RHYTHMRISE"],"Stabilizer":["MINI","MAX","VG50"]};
const PRODUCTS=[];Object.keys(CAT).forEach(c=>CAT[c].forEach(n=>PRODUCTS.push({code:c.toUpperCase()+"-"+n.replace(/\s+/g,"").toUpperCase(),name:n,cat:c,unit:"pcs"})));

const $=i=>document.getElementById(i);
const esc=s=>String(s==null?"":s).replace(/[&<>"]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]));
const today=()=>new Date().toISOString().slice(0,10);
function msg(id,t,ok){const m=$(id);m.className="msg "+(ok?"ok":"err");m.textContent=t;setTimeout(()=>m.className="msg",4000)}

let tx=[],user=null,isAdmin=false,db=null,auth=null,unsub=null;

if(firebaseConfig.apiKey.startsWith("PASTE")){
  msg("lm","Firebase is not set up yet. Paste your config in index.html.",false);
}else{
  const app=initializeApp(firebaseConfig);
  auth=getAuth(app);db=getFirestore(app);
  onAuthStateChanged(auth,u=>{
    if(u){user=u.email;isAdmin=ADMINS.indexOf(user.toLowerCase())>-1;start()}
    else{user=null;if(unsub){unsub();unsub=null}$("app").classList.add("hide");$("login").classList.remove("hide")}
  });
}

$("loginBtn").onclick=async()=>{
  if(!auth)return msg("lm","Firebase is not set up yet",false);
  try{await signInWithEmailAndPassword(auth,$("lu").value.trim(),$("lp").value);$("lp").value=""}
  catch(e){msg("lm","Wrong email or password",false)}
};
document.addEventListener("keydown",e=>{if(e.key==="Enter"&&!$("login").classList.contains("hide"))$("loginBtn").click()});
$("logoutBtn").onclick=()=>signOut(auth);

function start(){
  $("login").classList.add("hide");$("app").classList.remove("hide");
  $("who").textContent="Logged in as "+user+(isAdmin?" (admin)":"");
  $("i_d").value=today();$("o_d").value=today();fillProducts();
  $("cs").textContent="Connecting to cloud…";
  unsub=onSnapshot(collection(db,"tx"),s=>{
    tx=s.docs.map(d=>d.data()).sort((a,b)=>a.id-b.id);
    $("cs").textContent="☁ Cloud connected";render();
  },e=>{$("cs").textContent="Cloud error: "+e.code});
}

$("tabs").addEventListener("click",e=>{
  const t=e.target.getAttribute("data-t");if(!t)return;
  ["stock","inward","outward","history"].forEach(x=>$("t-"+x).classList.toggle("hide",x!==t));
  Array.prototype.forEach.call($("tabs").children,b=>b.classList.toggle("on",b===e.target));
});

function items(){
  const m={};
  PRODUCTS.forEach(p=>m[p.code]={code:p.code,name:p.name,unit:p.unit,cat:p.cat,i:0,o:0});
  tx.forEach(t=>{
    const o=m[t.code]||(m[t.code]={code:t.code,name:t.name,unit:t.unit,cat:"Other",i:0,o:0});
    if(t.type==="IN"){o.i+=t.qty;o.unit=t.unit||o.unit}else o.o+=t.qty;
  });
  return Object.keys(m).map(k=>{m[k].bal=m[k].i-m[k].o;return m[k]});
}
function render(){
  const it=items(),q=($("q").value||"").toLowerCase();
  $("stk").innerHTML=it.filter(x=>(x.code+x.name+x.cat).toLowerCase().indexOf(q)>-1).map(x=>
    `<tr><td>${esc(x.cat)}</td><td>${esc(x.name)}</td><td>${esc(x.unit)}</td><td class="in">${x.i}</td><td class="out">${x.o}</td><td><b class="${x.bal<=0?"bad":""}">${x.bal}</b></td></tr>`
  ).join("")||"<tr><td colspan='6' class='mu'>No products found.</td></tr>";
  $("s1").textContent=it.length;
  $("s2").textContent=it.reduce((a,x)=>a+x.i,0);
  $("s3").textContent=it.reduce((a,x)=>a+x.o,0);
  const cur=$("o_c").value;
  $("o_c").innerHTML=it.map(x=>`<option value="${esc(x.code)}">${esc(x.cat)} – ${esc(x.name)} (${x.bal})</option>`).join("");
  if(cur)$("o_c").value=cur;avail();
  $("hist").innerHTML=tx.slice().reverse().map(t=>{
    const del=isAdmin?`<button class="sm" data-del="${t.id}">Delete</button>`:"";
    return `<tr><td>${esc(t.date)}</td><td class="${t.type==="IN"?"in":"out"}">${t.type==="IN"?"Inward":"Outward"}</td><td>${esc(t.code)}</td><td>${esc(t.name)}</td><td>${t.qty} ${esc(t.unit)}</td><td>${esc(t.party)}</td><td>${esc(t.ref)}</td><td>${esc(t.by)}</td><td>${del}</td></tr>`;
  }).join("")||"<tr><td colspan='9' class='mu'>No entries yet.</td></tr>";
}
function fillProducts(){
  const cat=$("i_cat").value;
  $("i_c").innerHTML=PRODUCTS.filter(p=>p.cat===cat).map(p=>`<option value="${esc(p.code)}">${esc(p.name)}</option>`).join("");
}
function avail(){
  const x=items().filter(i=>i.code===$("o_c").value)[0];
  $("o_a").textContent=x?"Available: "+x.bal+" "+x.unit:"";
}
$("q").oninput=render;$("i_cat").onchange=fillProducts;$("o_c").onchange=avail;

async function save(o,mid){
  try{await setDoc(doc(db,"tx",String(o.id)),o);return true}
  catch(e){msg(mid,"Save failed: "+(e.code||e.message),false);return false}
}
$("addIn").onclick=async()=>{
  const c=$("i_c").value,p=PRODUCTS.filter(x=>x.code===c)[0],q=parseFloat($("i_q").value);
  if(!p||!(q>0))return msg("im","Select a product and enter a quantity above 0",false);
  const ok=await save({id:Date.now(),type:"IN",date:$("i_d").value||today(),code:c,name:p.name,unit:$("i_u").value.trim(),qty:q,party:$("i_p").value.trim(),ref:$("i_r").value.trim(),remarks:$("i_k").value.trim(),by:user},"im");
  if(ok){["i_q","i_p","i_r","i_k"].forEach(i=>$(i).value="");msg("im","Inward saved",true)}
};
$("addOut").onclick=async()=>{
  const c=$("o_c").value,q=parseFloat($("o_q").value),x=items().filter(i=>i.code===c)[0];
  if(!x||!(q>0))return msg("om","Select an item and enter a quantity above 0",false);
  if(q>x.bal)return msg("om","Not enough stock. Available: "+x.bal+" "+x.unit,false);
  const ok=await save({id:Date.now(),type:"OUT",date:$("o_d").value||today(),code:c,name:x.name,unit:x.unit,qty:q,party:$("o_p").value.trim(),ref:$("o_r").value.trim(),remarks:$("o_k").value.trim(),by:user},"om");
  if(ok){["o_q","o_p","o_r","o_k"].forEach(i=>$(i).value="");msg("om","Outward saved",true)}
};
$("hist").addEventListener("click",async e=>{
  const id=e.target.getAttribute("data-del");if(!id||!isAdmin)return;
  if(!confirm("Delete this entry?"))return;
  const old=tx;tx=tx.filter(t=>String(t.id)!==id);
  const bad=items().some(i=>i.bal<0);tx=old;
  if(bad)return alert("Can’t delete: stock would go negative.");
  try{await deleteDoc(doc(db,"tx",id))}catch(err){alert("Delete failed: "+(err.code||err.message))}
});
$("csvBtn").onclick=()=>{
  const h=["Date","Type","Code","Item","Unit","Qty","Party","Ref","Remarks","By"];
  const rows=tx.map(t=>[t.date,t.type,t.code,t.name,t.unit,t.qty,t.party,t.ref,t.remarks,t.by].map(v=>'"'+String(v==null?"":v).replace(/"/g,'""')+'"').join(","));
  const blob=new Blob([[h.join(",")].concat(rows).join("\n")],{type:"text/csv"});
  const a=document.createElement("a");a.href=URL.createObjectURL(blob);a.download="mrl-stock-"+today()+".csv";a.click();
};
</script>
</body>
</html>
